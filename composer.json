{
    "name": "david-grosskost/suitecrm-ext-custom-theme",
    "description": "Rail vertical et couleurs de l'entreprise pour SuiteCRM 8.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.30"
    },
    "autoload-dev": {
        "psr-4": {
            "SuiteCrmExt\\CustomTheme\\": "legacy/include/custom-theme/",
            "SuiteCrmExt\\CustomTheme\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
